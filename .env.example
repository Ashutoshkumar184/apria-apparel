# Razorpay Dashboard → Account & Settings → API Keys (use Test Mode first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required for the first owner setup. Use a random secret (at least 32 characters).
ADMIN_SETUP_TOKEN=
# Required for secure admin sessions. Use a different random secret (at least 32 characters).
ADMIN_SESSION_SECRET=

# Public customer support contact. Include country code, digits only.
WHATSAPP_NUMBER=917888329606

# Optional flat delivery charge, in paise. 0 means no delivery charge.
SHIPPING_FEE_PAISE=0
